{
  "name": "@harbor/engine",
  "version": "0.2.0",
  "private": true,
  "description": "An AI-friendly modular Web 3D runtime with GPU-free simulation",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    "./browser": {
      "types": "./lib/browser/index.d.ts",
      "import": "./lib/browser/index.js"
    },
    ".": {
      "types": "./lib/core/index.d.ts",
      "import": "./lib/core/index.js"
    },
    "./physics": {
      "types": "./lib/physics/index.d.ts",
      "import": "./lib/physics/index.js"
    },
    "./render": {
      "types": "./lib/render/index.d.ts",
      "import": "./lib/render/index.js"
    },
    "./assets": {
      "types": "./lib/assets/index.d.ts",
      "import": "./lib/assets/index.js"
    },
    "./platform": {
      "types": "./lib/platform/index.d.ts",
      "import": "./lib/platform/index.js"
    },
    "./raytrace": {
      "types": "./lib/raytrace/index.d.ts",
      "import": "./lib/raytrace/index.js"
    },
    "./pathtracing": {
      "types": "./lib/pathtracing/index.d.ts",
      "import": "./lib/pathtracing/index.js"
    },
    "./application": {
      "types": "./lib/application/index.d.ts",
      "import": "./lib/application/index.js"
    },
    "./narrative": {
      "types": "./lib/narrative/index.d.ts",
      "import": "./lib/narrative/index.js"
    },
    "./spatial": {
      "types": "./lib/spatial/index.d.ts",
      "import": "./lib/spatial/index.js"
    }
  },
  "files": [
    "lib",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "public/licenses",
    "public/oidn",
    "AGENTS.md"
  ],
  "scripts": {
    "create-game": "npm run build:engine && node tools/create-game.mjs",
    "dev": "vite --host 127.0.0.1 --port 5190",
    "preview": "vite preview --host 127.0.0.1 --port 5190",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "build:engine": "tsc -p tsconfig.lib.json",
    "build": "npm run typecheck && npm run build:engine && vite build",
    "scene": "tsx tools/scene.ts",
    "export": "npm run build && node tools/export.mjs",
    "check": "npm run test && npm run build",
    "check:consumer": "npm run build:engine && node tools/check-consumer.mjs",
    "test:render": "node tests/render-lifecycle.mjs",
    "assets": "tsx tools/assets.ts",
    "test:quality": "npm run build:engine && node tests/pathtracing.mjs",
    "bench:gpu": "node tests/gpu-benchmark.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@types/three": "0.186.0",
    "@webgpu/types": "0.1.74",
    "oidn-web": "0.5.0",
    "three": "0.186.1",
    "three-gpu-pathtracer": "0.0.27",
    "three-mesh-bvh": "0.9.15",
    "xatlas-web": "0.1.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@types/node": "26.6.5",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "1.3.0",
    "playwright-core": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
